# @BotFather dan olingan bot tokeni
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Admin(lar)ning Telegram ID raqami. Bir nechta bo'lsa vergul bilan: 111,222
ADMIN_IDS=123456789

# Vaqt mintaqasi (test boshlanish/tugash vaqtlari shu bo'yicha hisoblanadi)
TIMEZONE=Asia/Tashkent

# Ma'lumotlar bazasi fayli
DB_PATH=bot.db

# --- Faqat serverda (Render va h.k.) kerak, kompyuterda bo'sh qoldiring ---
# PostgreSQL bazasi (masalan Neon). Bo'sh bo'lsa SQLite fayli (DB_PATH) ishlatiladi.
# DATABASE_URL=postgresql://user:parol@host/neondb?sslmode=require
# Webhook manzili. Render'da avtomatik (RENDER_EXTERNAL_URL), boshqa hostingda qo'lda yoziladi.
# WEBHOOK_URL=https://sizning-bot.onrender.com
